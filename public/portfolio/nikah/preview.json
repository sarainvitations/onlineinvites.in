{"html": "<!doctype html>\n<html lang=\"en\">\n\n<head>\n    <base href=\"/portfolio/nikah/\">\n    <meta name=\"robots\" content=\"noindex, nofollow\">\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n    <meta name=\"theme-color\" content=\"#062d27\">\n    <title>F ✦ S</title>\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:title\" content=\"Mohammed Fahed &amp; Sakina Khatoon | Nikah &amp; Walima\">\n    <meta property=\"og:url\" content=\"https://wedding.fahed.in/\">\n    <meta property=\"og:image\" content=\"https://wedding.fahed.in/assets/images/wedding-preview-v2.jpg\">\n    <meta property=\"og:image:secure_url\" content=\"https://wedding.fahed.in/assets/images/wedding-preview-v2.jpg\">\n    <meta property=\"og:image:type\" content=\"image/jpeg\">\n    <meta property=\"og:image:width\" content=\"1200\">\n    <meta property=\"og:image:height\" content=\"630\">\n    <meta property=\"og:image:alt\" content=\"Mohammed Fahed &amp; Sakina Khatoon | Nikah &amp; Walima\">\n    <meta name=\"twitter:image\" content=\"https://wedding.fahed.in/assets/images/wedding-preview-v2.jpg\">\n    <meta name=\"twitter:image:alt\" content=\"Mohammed Fahed &amp; Sakina Khatoon | Nikah &amp; Walima\">\n    <meta property=\"og:locale\" content=\"en_IN\">\n    <meta name=\"twitter:card\" content=\"summary_large_image\">\n    <meta name=\"twitter:title\" content=\"Mohammed Fahed &amp; Sakina Khatoon | Nikah &amp; Walima\">\n    <link rel=\"preload\" href=\"/portfolio/nikah/assets/fonts/great-vibes.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n    <link rel=\"preload\" href=\"/portfolio/nikah/assets/fonts/noto-nastaliq-urdu.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n    <link rel=\"preload\" href=\"/portfolio/nikah/assets/fonts/cormorant-infant-medium.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n    <link rel=\"preload\" href=\"/portfolio/nikah/assets/fonts/cormorant-infant-medium-italic.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n\n\n\n    <link rel=\"stylesheet\" href=\"/portfolio/nikah/styles.css?v=22b0d89996\">\n    <link rel=\"icon\" href=\"/portfolio/nikah/favicon.ico?v=2\" sizes=\"any\">\n    <link rel=\"icon\" href=\"/portfolio/nikah/assets/icons/favicon.svg?v=2\" type=\"image/svg+xml\">\n    <link rel=\"icon\" href=\"/portfolio/nikah/assets/icons/favicon-32.png?v=2\" type=\"image/png\" sizes=\"32x32\">\n    <link rel=\"apple-touch-icon\" href=\"/portfolio/nikah/assets/icons/apple-touch-icon.png?v=2\" sizes=\"180x180\">\n</head>\n\n<body>\n    <a class=\"skip-link\" href=\"#main\">Skip to invitation</a>\n    <div id=\"gate\" class=\"gate\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Open the wedding invitation\" hidden>\n        <div class=\"gate-top\" lang=\"ar\" dir=\"rtl\">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>\n        <div class=\"doors\">\n            <div class=\"door left\"><span class=\"door-panel\" aria-hidden=\"true\"><span class=\"door-motif\">✥</span><span\n                        class=\"door-handle\"></span></span></div>\n            <div class=\"door right\"><span class=\"door-panel\" aria-hidden=\"true\"><span class=\"door-motif\">✥</span><span\n                        class=\"door-handle\"></span></span></div>\n        </div>\n        <div class=\"gate-front\">\n            <div class=\"eyebrow\">THE WEDDING CELEBRATION OF</div>\n            <h2 class=\"couple-names\">\n                        <span class=\"bilingual-name\"><span class=\"urdu person-urdu\" lang=\"ur\" dir=\"rtl\">محمد فہد</span><span class=\"person-name\" lang=\"en\">Mohammed Fahed</span></span>\n                        <span class=\"couple-divider\">—</span>\n                        <span class=\"bilingual-name\"><span class=\"urdu person-urdu\" lang=\"ur\" dir=\"rtl\">سکینہ خاتون</span><span class=\"person-name\" lang=\"en\">Sakina Khatoon</span></span>\n                    </h2><button id=\"enter\" class=\"primary\">✧ Open\n                Invitation ✧</button>\n            <p class=\"hint\">20 & 21 November 2026</p>\n        </div>\n    </div>\n    <div id=\"invitation\">\n        <div class=\"invitation-monogram\"><span class=\"monogram\" aria-label=\"Mohammed and Sakina\">F <i aria-hidden=\"true\">✦</i> S</span>\n            <button id=\"music\" class=\"audio-toggle\" type=\"button\" aria-pressed=\"false\" aria-label=\"Play vocals-only nasheed\" title=\"Play nasheed\">\n                <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n                    <path d=\"M11 5 6 9H3v6h3l5 4V5Z\"/>\n                    <path class=\"audio-waves\" d=\"M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14\"/>\n                    <path class=\"audio-muted\" d=\"m16 9 5 6m0-6-5 6\"/>\n                </svg>\n            </button>\n        </div>\n        <main id=\"main\" tabindex=\"-1\">\n            <section class=\"hero ornament\">\n                <div class=\"arch\">\n                    <div class=\"mini reveal\" lang=\"ar\" dir=\"rtl\">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>\n                    <div class=\"eyebrow reveal\">WITH THE BLESSINGS OF ALLAH</div>\n                    <p class=\"hero-prelude reveal invitation-line\">Two hearts, one beautiful beginning</p>\n                    <div class=\"flourish\">❦</div>\n                    <h1 class=\"couple-names\">\n                        <span class=\"bilingual-name reveal\"><span class=\"urdu person-urdu\" lang=\"ur\" dir=\"rtl\">محمد فہد</span><span class=\"person-name\" lang=\"en\">Mohammed Fahed</span></span>\n                        <span class=\"couple-divider reveal\">—</span>\n                        <span class=\"bilingual-name reveal\"><span class=\"urdu person-urdu\" lang=\"ur\" dir=\"rtl\">سکینہ خاتون</span><span class=\"person-name\" lang=\"en\">Sakina Khatoon</span></span>\n                    </h1>\n                    <p class=\"reveal invitation-line\">Request the honour of your presence and prayers</p>\n                    <div class=\"date-mark reveal\">20 — 21 NOVEMBER 2026</div><a class=\"scroll reveal\" href=\"#nikah\">Discover the\n                        celebration ↓</a>\n                </div>\n            </section>\n            <section class=\"intro\">\n                <div class=\"star\">✦</div>\n                <h2 class=\"reveal\">With love, gratitude & duas</h2>\n                <p class=\"reveal invitation-line\">We warmly invite you to share in the joy of our Nikah and Dawat-e-Walima.</p>\n                <p class=\"urdu reveal\" lang=\"ur\" dir=\"rtl\">آپ کی تشریف آوری اور دعائیں ہمارے لیے باعثِ مسرت ہوں گی۔</p>\n            </section>\n            <section id=\"celebrations\" class=\"event combined-events\" aria-label=\"Nikah and Walima celebrations\">\n                <div class=\"event-card\">\n                    <section id=\"nikah\" class=\"ceremony\" aria-labelledby=\"nikah-heading\">\n                        <div class=\"event-icon\" aria-hidden=\"true\">\n                            <svg class=\"crescent-icon\" viewBox=\"0 0 48 48\" width=\"40\" height=\"40\" fill=\"none\" focusable=\"false\">\n                                <path d=\"M30 5a19 19 0 1 0 13 30A17 17 0 0 1 30 5Z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n                                <path d=\"m36 12 1.6 4.9h5.2l-4.2 3.1 1.6 4.9-4.2-3-4.2 3 1.6-4.9-4.2-3.1h5.2Z\" fill=\"currentColor\"/>\n                            </svg>\n                        </div>\n                        <h2 id=\"nikah-heading\" class=\"reveal\">Nikah Ceremony</h2>\n                        <p class=\"urdu title-urdu reveal\" lang=\"ur\" dir=\"rtl\">تقریبِ نکاح</p>\n                        <div class=\"day reveal\">FRIDAY</div>\n                        <time class=\"bigdate reveal\" datetime=\"2026-11-20\">20 <small>NOVEMBER</small> 2026</time>\n                        <div class=\"time reveal\"><time datetime=\"2026-11-20T15:00:00+05:30\">3:00 PM</time></div>\n                        <p class=\"urdu departure-urdu reveal\" lang=\"ur\" dir=\"rtl\">بارات کی روانگی</p>\n                        <p class=\"departure-note reveal\">Departure from our residence</p>\n                    </section>\n                    <div class=\"ceremony-divider\" aria-hidden=\"true\"><span>✧</span></div>\n                    <section id=\"walima\" class=\"ceremony\" aria-labelledby=\"walima-heading\">\n                        <h2 id=\"walima-heading\" class=\"reveal\">Dawat-e-Walima</h2>\n                        <p class=\"urdu title-urdu reveal\" lang=\"ur\" dir=\"rtl\">دعوتِ ولیمہ</p>\n                        <div class=\"day reveal\">SATURDAY</div>\n                        <time class=\"bigdate reveal\" datetime=\"2026-11-21T18:30:00+05:30\">21 <small>NOVEMBER</small> 2026</time>\n                        <div class=\"time reveal\">6:30 PM onwards</div>\n                    </section>\n                    <div class=\"shared-venue\">\n                        <p id=\"shared-location\" class=\"eyebrow reveal\">Our Residence</p>\n                        <p class=\"venue reveal\">Village Jaurahi, Sauraha Buzurg<br>District Kushinagar, Uttar Pradesh</p>\n                        <p class=\"urdu venue-urdu reveal\" lang=\"ur\" dir=\"rtl\">گاؤں جوراہی، سوراہا بزرگ، ضلع کشی نگر، اتر پردیش</p>\n                        <a class=\"primary action reveal\" target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://maps.app.goo.gl/1qyPs6acX2WrdcoG9\">↗ Location</a>\n                    </div>\n                </div>\n            </section>\n            <section class=\"ending\">\n                <div class=\"star\">✦</div>\n                <h2 class=\"reveal\">Your presence is our blessing</h2>\n                <p class=\"urdu reveal\" lang=\"ur\" dir=\"rtl\">جزاکم اللہ خیراً</p>\n                <p class=\"reveal invitation-line\">We look forward to celebrating with you.</p>\n                <div class=\"monogram large\">F <i>✦</i> S</div>\n                <div class=\"rsvp\" aria-labelledby=\"rsvp-heading\">\n                    <h2 id=\"rsvp-heading\" class=\"reveal\">Will you join us?</h2>\n                    <p class=\"reveal\">Let us know your plans and leave a message or dua.</p>\n                    <form inert aria-label=\"Portfolio sample — responses disabled\" action='/rsvp-thanks' id='rsvp-form' method='POST' name='wedding-rsvp'>\n                        <input type=\"hidden\" name=\"form-name\" value=\"wedding-rsvp\">\n                        <div hidden><label>Leave this empty <input name=\"bot-field\" tabindex=\"-1\" autocomplete=\"off\"></label></div>\n                        <div class=\"form-field reveal\">\n                            <label for=\"guest-name\">Your name <span aria-hidden=\"true\">*</span></label>\n                            <input id=\"guest-name\" name=\"guest-name\" type=\"text\" autocomplete=\"name\" maxlength=\"120\" dir=\"auto\" required>\n                        </div>\n                        <div class=\"form-field reveal\">\n                            <label for=\"attendance\">Your availability <span aria-hidden=\"true\">*</span></label>\n                            <select id=\"attendance\" name=\"attendance\" required>\n                                <option value=\"\" disabled selected>Please select</option>\n                                <option value=\"both\">I’ll attend both celebrations</option>\n                                <option value=\"nikah\">Nikah / Baraat only</option>\n                                <option value=\"walima\">Walima only</option>\n                                <option value=\"unable\">Sorry, I’m unable to attend</option>\n                                <option value=\"unsure\">I’m not sure yet</option>\n                            </select>\n                        </div>\n                        <div class=\"form-field reveal\">\n                            <label for=\"guest-message\">Your message or dua <span class=\"optional\">(optional)</span></label>\n                            <textarea id=\"guest-message\" name=\"message\" rows=\"4\" maxlength=\"1500\" dir=\"auto\" placeholder=\"A few words for the couple…\"></textarea>\n                        </div>\n                        <button class=\"primary reveal\" type=\"submit\" disabled>Portfolio preview · responses disabled</button>\n                        <p id=\"rsvp-status\" class=\"form-status\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></p>\n                    </form>\n                </div>\n            </section>\n        </main>\n        <footer>Made with love and duas · November 2026</footer>\n    </div>\n    <p id=\"status\" class=\"status\" role=\"status\" aria-live=\"polite\"></p><audio id=\"nasheed\" loop preload=\"none\"\n        src=\"/portfolio/nikah/assets/audio/wedding-nasheed-2.mp3\"></audio>\n    <script src=\"/portfolio/nikah/script.js?v=audio-3\"></script>\n</body>\n\n</html>"}
